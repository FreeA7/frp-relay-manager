FRP_RELAY_SERVER_URL=https://panel.tunnel.freea7.fun
FRP_RELAY_ENROLLMENT_TOKEN=replace-with-enrollment-token
FRP_RELAY_HEARTBEAT_INTERVAL_SECONDS=30
FRP_RELAY_AGENT_STATE=/etc/frp-relay-agent/agent-state.json
FRP_RELAY_FRPC_CONFIG=/etc/frp-relay-agent/frpc.generated.toml
FRP_RELAY_FRPC_RELOAD_CMD=/bin/systemctl restart frp-relay-frpc.service
FRP_RELAY_FRPC_BINARY=/usr/local/bin/frpc
FRP_RELAY_DEVICE_IDENTITY=/etc/deep-assess/device-identity.json
FRP_RELAY_HARDWARE_RELEASE=/etc/deep-assess/release.json
FRP_RELAY_CLIENT_RELEASE=/etc/frp-relay-agent/release.json
FRP_RELAY_TENANT_BINDING=/var/lib/deep-assess/tenant-binding.json

# Optional overrides for the hardware summary auto-detected by the agent.
FRP_RELAY_HARDWARE_CPU_MODEL=
FRP_RELAY_HARDWARE_GPU_MODEL=
FRP_RELAY_HARDWARE_MEMORY_TOTAL_BYTES=
FRP_RELAY_HARDWARE_DISK_TOTAL_BYTES=
FRP_RELAY_HARDWARE_OS_VERSION=

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

WORKDIR /build
COPY server/frontend/package.json server/frontend/package-lock.json ./
RUN npm ci
COPY server/frontend/index.html server/frontend/vite.config.js ./
COPY server/frontend/src ./src
RUN npm run build

FROM nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
COPY deploy/docker/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/deepassess-core.conf /etc/nginx/proxy_params/deepassess-core.conf
COPY deploy/docker/deepassess-engine.conf /etc/nginx/proxy_params/deepassess-engine.conf
COPY --from=build /build/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-check-certificate --quiet --output-document=- --header='Host: panel.tunnel.freea7.fun' https://127.0.0.1/health >/dev/null || exit 1
